    "# Oppgave 2.5\n",
    "def find_closest(words, words_subset):\n",
    "    top_5 = {}\n",
    "\n",
    "    for word_subset in words_subset:\n",
    "        similar_words = []\n",
    "        for word in words:\n",
    "            if word_subset.lower() != word.lower():\n",
    "                score = cosine_similarity(word_subset.lower(), word.lower())\n",
    "                similar_words.append((word, score))\n",
    "        \n",
    "        similar_words.sort(key=lambda x : x[1], reverse = True)\n",
    "        top_5[word_subset] = similar_words[:5]\n",
    "    \n",
    "    return top_5\n",
    "\n",
    "def print_top_5(top_5):\n",
    "    for word, matches in top_5.items():\n",
    "        word_list = [m[0] for m in matches]\n",
    "        top_5_words = \", \".join(word_list)\n",
    "        print(f\"| {word} | {top_5_words}\")\n",
    "\n",
    "\n",
    "\n",
    "closest = find_closest(WORDS, WORDS_SUBSET)\n",
    "print_top_5(closest)\n"
