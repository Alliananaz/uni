    "# Oppgave 1.4\n",
    "def common_topwords(dataset):\n",
    "    top_words_list = []\n",
    "\n",
    "    for sentence in dataset:\n",
    "        top_words_list.extend(sentence)\n",
    "\n",
    "    ordteller = Counter(top_words_list)\n",
    "    topp10k = set([word for word, freq in ordteller.most_common(10000)])\n",
    "    return topp10k\n",
    "\n",
    "topp10k = common_topwords(filtered_dataset)\n",
    "\n",
    "def keep_top_words(dataset, topp_words):\n",
    "    keep_common_dataset = []\n",
    "    for sentence in dataset:\n",
    "        new_sentence = []\n",
    "        for word in sentence:\n",
    "            if word in topp_words:\n",
    "                new_sentence.append(word)\n",
    "        keep_common_dataset.append(new_sentence)\n",
    "\n",
    "    return keep_common_dataset\n",
    "\n",
    "filtered_keep_common = keep_top_words(filtered_dataset, topp10k)\n",
    "beregn(filtered_keep_common)\n",
    "\n",
