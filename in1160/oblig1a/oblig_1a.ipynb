   "source": [
    "# Oppgave 2.1\n",
    "# vocab = list(filtered_keep_common)\n",
    "\n",
    "def ord_til_tall(dataset):\n",
    "    vocab = list(set(word.lower() for sentence in dataset for word in sentence))\n",
    "    word_to_int = {}\n",
    "    int_to_word = {}\n",
    "\n",
    "    for i, word in enumerate(vocab):\n",
    "        word_to_int[word] = i\n",
    "        int_to_word[i] = word\n",
