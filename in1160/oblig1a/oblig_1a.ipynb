    "# Beregn antall ord og ordtyper her:\n",
    "def beregn(dataset):\n",
    "    types = set()\n",
    "    tokens = 0\n",
    "    ordtyper = 0\n",
    "\n",
    "    for sentence in dataset:\n",
    "        tokens += len(sentence)\n",
    "\n",
    "        for word in sentence:\n",
    "            if word not in types:\n",
    "                types.add(word)\n",
    "                ordtyper += 1\n",
    "\n",
    "    print(f\"tokens : {tokens}\")\n",
    "    print(f\"ordtyper : {ordtyper}\")\n",
    "\n",
    "beregn(tokenized_dataset)"
   ]
  },
